# 導航任務設定範本。複製成 .env 後修改；.env 不會被提交到版本控制。
# 值請用雙引號包起來，Google Maps 網址含有 ! % & = 等字元。

# 目的地的 Google Maps 網址（在 Google Maps 開啟地點後，複製含座標的完整網址）。
# 建置時會從網址解析出店名與座標，導航連結也由此產生。
# 不支援 maps.app.goo.gl 短網址或只有 Place ID、沒有座標的網址。
NAV_DESTINATION_URL="https://www.google.com/maps/place/%E6%A3%B2%E6%89%80hechizos/@24.2459129,120.8342353,17z/data=!4m2!3m1!1s0x0:0xf9d9695c391f97ae"

# 允許開始任務的 GPS 範圍，單位公里，以目的地為圓心的半徑。
NAV_RADIUS_KM=5
