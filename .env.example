# 導航任務設定範本。複製成 .env 後修改；.env 不會被提交到版本控制。
# 值請用雙引號包起來，Google Maps 網址含有 ! % & = 等字元。

# 目的地的 Google Maps 網址（在 Google Maps 開啟地點後，複製瀏覽器網址列的完整網址）。
# 建置時會從網址解析出店名與座標，導航連結也由此產生。
# 不支援 maps.app.goo.gl 短網址，請貼完整網址。
NAV_DESTINATION_URL="https://www.google.com/maps/place/..."

# 允許開始任務的 GPS 範圍，單位公里，以目的地為圓心的半徑。
NAV_RADIUS_KM=5
